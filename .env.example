DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexa_ai"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/nexa_ai"
APP_URL="http://localhost:3000"
SESSION_SECRET="replace-with-a-long-random-secret"
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"
OPENROUTER_API_KEY=""
OPENROUTER_MODEL="openrouter/free"
OPENROUTER_APP_NAME="Nexa AI"
OPENROUTER_APP_URL="http://localhost:3000"
# Deployment auth: keep this in GitHub Actions only; do not expose it to the Worker runtime.
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
# Runtime Workers AI token. Use a narrowly-scoped token, separate from deployment auth.
CLOUDFLARE_AI_API_TOKEN=""
CLOUDFLARE_MODEL="@cf/zai-org/glm-4.7-flash"
AI_PROVIDER_TIMEOUT_MS="15000"
AI_MAX_RETRIES_PER_PROVIDER="2"
AI_COOLDOWN_SECONDS="120"
AI_FAILURES_BEFORE_COOLDOWN="3"
