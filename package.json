{
  "name": "ai-saas-platform",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:push && npm run db:seed && npm run security:baseline && next build",
    "start": "next start",
    "dev:vinext": "vinext dev --port 3001",
    "build:vinext": "vinext build",
    "start:vinext": "wrangler dev --config dist/server/wrangler.json",
    "deploy:vinext": "vinext-cloudflare deploy --config dist/server/wrangler.json",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "security:baseline": "tsx scripts/security-baseline.ts",
    "postinstall": "prisma generate",
    "check:project": "node scripts/check-project.mjs",
    "check:i18n": "node scripts/check-i18n.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vinext/cloudflare": "1.0.0-beta.7",
    "bcryptjs": "latest",
    "clsx": "latest",
    "dotenv": "latest",
    "lucide-react": "1.39.0",
    "next": "16.3.3",
    "next-themes": "0.4.6",
    "pg": "latest",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.87.0",
    "react-markdown": "10.1.0",
    "react-server-dom-webpack": "19.2.8",
    "recharts": "latest",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "latest",
    "vinext": "1.0.0-beta.9",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.4",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "@vitejs/plugin-react": "^6.0.0",
    "@vitejs/plugin-rsc": "^0.5.34",
    "prisma": "7.10.0",
    "tailwindcss": "4.3.3",
    "tsx": "latest",
    "typescript": "7.0.2",
    "vite": "^8.0.0",
    "wrangler": "4.129.0"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "packageManager": "npm@10.9.2"
}
